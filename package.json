{
	"name": "obsidian-gpgCrypt",
	"version": "0.5.0",
	"description": "Seamlessly encrypts your notes using GPG. Supports smartcards for enhanced security! Keep your information safe and accessible only to you.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs development",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"typecheck": "tsc -noEmit -skipLibCheck -p tsconfig.json && tsc -noEmit -p tests/tsconfig.json && tsc -noEmit -p e2e/tsconfig.json",
		"typecheck:drift": "node scripts/typings-drift.mjs",
		"check:versions": "node scripts/check-versions.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run --project unit",
		"test:component": "vitest run --project component",
		"test:integration": "vitest run --project integration",
		"test:coverage": "vitest run --coverage",
		"test:gpg": "vitest run --project unit tests/unit/backend/wrapper/BackendWrapper.gpg.test.ts",
		"pretest:e2e": "npm run build",
		"test:e2e": "node scripts/e2e.mjs",
		"e2e:watch": "npm run build && obsidian-launcher watch --version latest --copy --plugin ./dist e2e/vaults/basic",
		"gen:fixtures": "node scripts/gen-test-fixtures.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Tjado Mäcke",
	"homepage": "https://github.com/tejado/obsidian-gpgCrypt",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@fast-check/vitest": "0.4.1",
		"@openpgp/web-stream-tools": "^0.1.3",
		"@stylistic/eslint-plugin": "5.10.0",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@types/mocha": "10.0.10",
		"@types/node": "^22.10.5",
		"@vitest/coverage-v8": "4.1.10",
		"@wdio/cli": "9.30.1",
		"@wdio/globals": "9.29.1",
		"@wdio/local-runner": "9.30.1",
		"@wdio/mocha-framework": "9.30.1",
		"@wdio/types": "9.30.1",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.24.2",
		"esbuild-copy-static-files": "^0.1.0",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.1",
		"fast-check": "4.9.0",
		"globals": "17.11.0",
		"happy-dom": "20.11.2",
		"obsidian": "1.12.3",
		"obsidian-launcher": "3.1.3",
		"openpgp": "^6.0.1",
		"tslib": "2.8.1",
		"tsx": "4.23.12",
		"typescript": "5.7.2",
		"typescript-eslint": "8.67.0",
		"vitest": "4.1.10",
		"wdio-obsidian-reporter": "3.1.3",
		"wdio-obsidian-service": "3.1.3",
		"webdriverio": "9.30.1"
	}
}
