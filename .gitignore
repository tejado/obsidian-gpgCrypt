# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js
/styles.css

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Exclude build output directory
dist/

# Testing
coverage/
logs/
.obsidian-cache/
obsidian-versions-lock.txt
e2e/vaults/*/.obsidian/workspace*.json
e2e/vaults/*/.trash/
# The global data.json rule above must not drop the committed e2e fixture preset
!e2e/vaults/**/data.json
